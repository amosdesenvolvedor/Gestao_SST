generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SST_MANAGER
  SAFETY_ENGINEER
  SAFETY_TECHNICIAN
  OCCUPATIONAL_PHYSICIAN
  RH
  FINANCIAL
  CLIENT
  VIEWER
}

enum ProfessionalType {
  OCCUPATIONAL_PHYSICIAN
  SAFETY_ENGINEER
  SAFETY_TECHNICIAN
  OTHER
}

enum DocumentType {
  CNPJ
  CPF
  OTHER
}

enum ClientStatus {
  PROSPECT
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EstablishmentStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ServiceCategory {
  TECHNICAL_DOCUMENT
  OCCUPATIONAL_HEALTH
  OCCUPATIONAL_SAFETY
  MANAGEMENT
  TRAINING
  CONSULTING
  OTHER
}

enum ContractStatus {
  DRAFT
  IN_REVIEW
  READY_FOR_SIGNATURE
  AWAITING_SIGNATURE
  SIGNED
  ACTIVE
  EXPIRING
  ENDED
  TERMINATED
  CANCELLED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BANK_TRANSFER
  BOLETO
  OTHER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  professional Professional?
  clientMemberships ClientMembership[]

  @@index([role])
}

model Client {
  id                    String          @id @default(cuid())
  legalName             String
  tradeName             String?
  taxIdType             DocumentType?
  taxIdNumberNormalized String?         @unique
  stateRegistration     String?
  municipalRegistration String?
  cnaeMain              String?
  cnaeSecondary         String[]
  sizeCategory          String?
  status                ClientStatus    @default(PROSPECT)
  notes                 String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  establishments Establishment[]
  contacts       ClientContact[]
  contracts      Contract[]
  memberships    ClientMembership[]

  @@index([legalName])
  @@index([status])
}

model ClientMembership {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@unique([userId, clientId])
  @@index([userId, isActive])
  @@index([clientId, isActive])
}

model Establishment {
  id                    String              @id @default(cuid())
  clientId              String
  nickname              String?
  taxIdType             DocumentType?
  taxIdNumberNormalized String?             @unique
  stateRegistration     String?
  isHeadquarters        Boolean             @default(false)
  status                EstablishmentStatus @default(ACTIVE)
  cnaeMain              String?
  cnaeSecondary         String[]
  employeeCount         Int?
  contactEmail          String?
  contactPhone          String?
  postalCode            String
  street                String
  number                String
  complement            String?
  neighborhood          String
  city                  String
  state                 String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  contractLinks ContractEstablishment[]

  @@index([clientId, status])
  @@index([clientId, city])
  @@index([clientId, state])
  @@index([clientId, isHeadquarters])
}

model ServiceCatalog {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  description String?
  category    ServiceCategory
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  contractServices ContractService[]

  @@index([name])
  @@index([isActive])
  @@index([sortOrder])
}

model Contract {
  id                 String         @id @default(cuid())
  clientId           String
  renewedFromId      String?
  contractNumber     String         @unique
  title              String
  status             ContractStatus @default(DRAFT)
  startDate          DateTime
  endDate            DateTime
  durationMonths     Int
  currency           String         @default("BRL")
  totalValue         Decimal        @db.Decimal(14, 2)
  monthlyBaseValue   Decimal        @db.Decimal(14, 2)
  dueDay             Int
  paymentMethod      PaymentMethod
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  client               Client                 @relation(fields: [clientId], references: [id], onDelete: Restrict)
  renewedFromContract  Contract?              @relation("ContractRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedContracts     Contract[]             @relation("ContractRenewal")
  services             ContractService[]
  establishments       ContractEstablishment[]

  @@index([clientId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@index([clientId, status])
}

model ContractService {
  id                         String          @id @default(cuid())
  contractId                 String
  serviceCatalogId           String
  serviceCodeSnapshot        String
  serviceNameSnapshot        String
  serviceDescriptionSnapshot String?
  serviceCategorySnapshot    ServiceCategory
  descriptionOverride        String?
  quantity                   Int             @default(1)
  unitValue                  Decimal?        @db.Decimal(14, 2)
  totalValue                 Decimal?        @db.Decimal(14, 2)
  isActive                   Boolean         @default(true)
  notes                      String?
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt

  contract       Contract       @relation(fields: [contractId], references: [id], onDelete: Restrict)
  serviceCatalog ServiceCatalog @relation(fields: [serviceCatalogId], references: [id], onDelete: Restrict)

  @@unique([contractId, serviceCatalogId])
  @@index([contractId])
  @@index([serviceCatalogId])
  @@index([contractId, isActive])
}

model ContractEstablishment {
  contractId      String
  establishmentId String
  createdAt       DateTime @default(now())

  contract      Contract      @relation(fields: [contractId], references: [id], onDelete: Restrict)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  @@id([contractId, establishmentId])
  @@index([contractId])
  @@index([establishmentId])
}

model ClientContact {
  id                String   @id @default(cuid())
  clientId          String
  name              String
  role              String?
  department        String?
  email             String?
  phone             String
  preferredChannel  String?
  isPrimary         Boolean  @default(false)
  receivesBilling   Boolean  @default(false)
  receivesReports   Boolean  @default(false)
  receivesAlerts    Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@index([clientId, isActive])
  @@index([clientId, isPrimary])
}

model Professional {
  id               String           @id @default(cuid())
  name             String
  email            String?
  phone            String?
  cpf              String?
  professionalType ProfessionalType
  councilType      String?
  councilNumber    String?
  councilState     String?
  specialty        String?
  isActive         Boolean          @default(true)
  userId           String?          @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name])
  @@index([professionalType])
  @@index([isActive])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  createdAt  DateTime @default(now())
  metadata   Json?

  @@index([action, entity])
  @@index([createdAt])
}