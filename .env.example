NODE_ENV=development

# API
API_HOST=0.0.0.0
API_PORT=3333
API_CORS_ORIGIN=http://localhost:5173
JWT_SECRET=change-me-with-a-strong-random-secret
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=gestao_sst_session

# PostgreSQL + Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestao_sst?schema=public

# Integration test database (must be isolated from development/production)
TEST_DATABASE_URL=__REQUIRED_SET_TEST_DATABASE_URL_WITH_APPLICATION_NAME__
DEVELOPMENT_DATABASE_URL=__REQUIRED_SET_DEVELOPMENT_DATABASE_URL__
PRODUCTION_DATABASE_URL=__REQUIRED_SET_PRODUCTION_DATABASE_URL__
TEST_DB_ALLOWED_HOSTS=__REQUIRED_COMMA_SEPARATED_TEST_HOSTS__
TEST_DB_ALLOWED_PORTS=__REQUIRED_COMMA_SEPARATED_TEST_PORTS__
TEST_DATABASE_NAME_REGEX=__REQUIRED_REGEX_FOR_TEST_DB_NAME__
TEST_DATABASE_REQUIRED_USERNAME=__REQUIRED_TEST_DB_USERNAME__
TEST_DATABASE_IDENTITY_MARKER=__REQUIRED_APPLICATION_NAME_MARKER__

# Frontend
VITE_API_BASE_URL=http://localhost:3333

# Mercado Pago Sandbox (somente testes)
MERCADO_PAGO_ENABLED=false
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_WEBHOOK_NOTIFICATION_URL=https://gestaosst.digital/api/v1/finance/webhooks/mercado-pago
MERCADO_PAGO_TIMEOUT_MS=10000
MERCADO_PAGO_SIGNATURE_TOLERANCE_SECONDS=300
MERCADO_PAGO_TEST_PAYER_EMAIL=test_user_123456@testuser.com

# Notificacoes por email (Resend)
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=Gestao SST
RESEND_ENABLED=false

# Bootstrap do primeiro admin (uso pontual em comando CLI)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador